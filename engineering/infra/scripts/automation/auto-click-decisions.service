[Unit]
Description=Approval Button Auto-Clicker
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
PassEnvironment=DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS
WorkingDirectory=/mnt/linuxshare/src/github.com/intellibitz/archives/engineering/infra/scripts/automation
ExecStart=/usr/bin/python3 -u /mnt/linuxshare/src/github.com/intellibitz/archives/engineering/infra/scripts/automation/auto_click_decisions.py
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target default.target

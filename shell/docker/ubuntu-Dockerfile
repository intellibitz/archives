# syntax=docker/dockerfile:1
# Dockerfile for Ubuntu 24.04 LTS Development Environment
# Build: docker build -f ubuntu-Dockerfile -t intellibitz/ubuntu:24.04 .
# Run:   docker run --name ubuntu --rm -it intellibitz/ubuntu:24.04

FROM ubuntu:26.04

LABEL maintainer="Muthu Ramadoss <muthu.ramadoss@gmail.com>"
LABEL description="Ubuntu 24.04 LTS Development Environment"

ARG USERNAME=muthu
ARG USER_UID=1000
ARG USER_GID=1000

ENV DEBIAN_FRONTEND=noninteractive
ENV SHELL=/bin/zsh

# Install core packages and development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
        sudo \
        curl \
        wget \
        git \
        ca-certificates \
        gnupg \
        zsh \
        nano \
        python3 \
        python3-pip \
        python3-venv \
    && groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/zsh $USERNAME \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME \
    && apt-get autoremove -y \
    && apt-get clean -y \
    && rm -rf /var/lib/apt/lists/*

USER $USERNAME
WORKDIR /home/$USERNAME

# Install Oh My Zsh unattended
RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" --unattended

ENTRYPOINT [ "/bin/zsh" ]

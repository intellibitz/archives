# ==========================================
# IntelliBitz Global .gitignore
# ==========================================

# --- OS Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- IDEs & Editors ---
# IntelliJ IDEA / Android Studio
.idea/
*.iml
*.iws
*.ipr
out/
.shelf/

# Eclipse
*.project
*.classpath
.settings/
.apt_generated/
.factorypath
.springBeans
.sts4-cache
bin/

# NetBeans
nbproject/
nbproject/private/
nbbuild.xml
build/
nbbuild/
dist/
nbdist/
.nb-attrs
.nb-gradle/

# Visual Studio Code
.vscode/
*.code-workspace

# Vim / Emacs / Sublime
*.swp
*~
*.bak
*.orig
.*.sw[a-z]
.sublime-*

# --- Java & Kotlin ---
*.class
*.jar
*.war
*.ear
*.nar
target/
classes/
test-classes/
.kotlin/

# --- Gradle ---
.gradle/
build/
!**/gradle/wrapper/gradle-wrapper.jar

# --- Android ---
local.properties
*keystore.properties
*.keystore
*.jks
*google-services.json
.externalNativeBuild/
.cxx/
captures/
*.apk
*.ap_
*.aab
*.dex
R.java

# --- Compiled Binaries & Libraries ---
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out

# --- Rust / Cargo ---
Cargo.lock
**/*.rs.bk

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# --- Node / JavaScript / Web ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.next/
*.tsbuildinfo

# --- Environment & Credentials ---
.env
.env.local
.env.*.local
*.key
*.pem
!*.example

# --- Logs & Databases ---
*.log
*.sqlite
*.sqlite3
*.db-journal
*.swf
*.rar

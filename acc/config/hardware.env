# HARDWARE PERFORMANCE TUNING
# ===========================

# CPU Scaling Governor (performance / powersave / ondemand)
CPU_GOVERNOR=performance

# NVIDIA GPU Persistence Mode (ON / OFF)
GPU_PERSISTENCE=ON

# GPU Power Limit (Watts or 'default')
GPU_POWER_LIMIT=default

# System Swappiness (0-100)
SYS_SWAPPINESS=1

# VFS Cache Pressure (0-100)
SYS_VFS_CACHE_PRESSURE=50

# Transparent Hugepages (always / madvise / never)
SYS_THP=always

# OLLAMA SERVICE PARAMETERS (USER TUNABLE)
# ========================================

# Model Persistence in RAM
OLLAMA_KEEP_ALIVE=24h

# Max models to load simultaneously
OLLAMA_MAX_LOADED_MODELS=1

# Parallel requests support
OLLAMA_NUM_PARALLEL=1

# Context Length Limit (32k/64k/128k)
OLLAMA_CONTEXT_LENGTH=32768

# KV Cache Quantization (q4_0 / f16)
OLLAMA_KV_CACHE_TYPE=q4_0

# GPU VRAM Reservation (MB) - Amount to keep FREE for OS
OLLAMA_GPU_OVERHEAD=1024

# Network Bind Address
OLLAMA_HOST=0.0.0.0:11434

# Flash Attention (0=off, 1=on)
OLLAMA_FLASH_ATTENTION=1

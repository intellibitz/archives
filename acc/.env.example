# AI Command Center (acc) Configuration
# ===================================

# Ollama Host (default: localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Hugging Face Token (optional, for gated models)
# HF_TOKEN=your_token_here

# Fleet Management Settings
MAX_MODELS_LOADED=1
KEEP_ALIVE_DURATION=24h

# Hardware Offloading
GPU_LAYERS_LARGE=20
GPU_LAYERS_SMALL=99
